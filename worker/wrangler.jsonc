{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pegma-dev-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pegma.dev/api/*",
      "zone_name": "pegma.dev",
    },
    {
      "pattern": "pegma.dev/.well-known/oauth-authorization-server",
      "zone_name": "pegma.dev",
    },
    {
      "pattern": "pegma.dev/.well-known/oauth-protected-resource/api/knowledge/mcp",
      "zone_name": "pegma.dev",
    },
  ],
  "vars": {
    // Controlled staff authoring qualification; registrations are not client acceptance.
    "PEGMA_KNOWLEDGE_ENABLED": "true",
    "PEGMA_SUPPORT_LEARNING_REVIEWS_ENABLED": "false",
    "PEGMA_AGENT_CLIENTS_JSON": "[{\"clientId\":\"pg-kb-codex-accept-v1\",\"name\":\"Pegma Codex CLI\",\"redirectUris\":[\"http://127.0.0.1/callback\"],\"allowedScopes\":[\"knowledge.article.draft.read\",\"knowledge.article.draft.write\",\"knowledge.article.evidence.submit\"],\"grantTypes\":[\"authorization_code\"]},{\"clientId\":\"pg-kb-claude-accept-v1\",\"name\":\"Pegma Claude Code\",\"redirectUris\":[\"http://localhost:48772/callback\"],\"allowedScopes\":[\"knowledge.article.draft.read\",\"knowledge.article.draft.write\",\"knowledge.article.evidence.submit\"],\"grantTypes\":[\"authorization_code\"]},{\"clientId\":\"pg-kb-device-accept-v1\",\"name\":\"Pegma RFC 8628 control\",\"redirectUris\":[],\"allowedScopes\":[\"knowledge.article.draft.read\",\"knowledge.article.draft.write\",\"knowledge.article.evidence.submit\"],\"grantTypes\":[\"device_code\"]},{\"clientId\":\"pg-kb-grok-accept-v1\",\"name\":\"Pegma Grok Bot\",\"redirectUris\":[\"https://www.cursor.com/agents/mcp/oauth/callback\"],\"allowedScopes\":[\"knowledge.article.draft.read\",\"knowledge.article.draft.write\",\"knowledge.article.evidence.submit\"],\"grantTypes\":[\"authorization_code\"]}]",
    "PEGMA_KNOWLEDGE_BROWSER_LIMIT": "120",
    "PEGMA_AGENT_RESOURCE_LIMIT": "300",
    "IDENTITY_EMAIL_FROM": "Pegma <identity@pegma.dev>",
    "IDENTITY_EMAIL_ENABLED": "true",
    "GITHUB_ORGANIZATION_ID": "309286193",
    "GITHUB_ALLOWED_REPOSITORY_IDS": "1312512520,1312519623,1312811498,1312961609,1312942188,1313911960,1313917945,1314116350,1314093835,1313927900,1314239450,1314421283,1313936481",
  },
  "triggers": {
    // Separate mail, rotating cleanup, isolated rate page, and release lanes.
    "crons": [
      "* * * * *",
      "1-59 * * * *",
      "0-58 * * * *",
      "0-57 * * * *",
      "0-59 */6 * * *",
    ],
  },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "pegma-dev-identity",
      "database_id": "fe188a7f-7b5e-4889-bcfc-6150b64d45ae",
      "migrations_dir": "migrations",
    },
  ],
  // Resource existence is verified before deploying this opt-in configuration.
  "queues": {
    "producers": [
      { "binding": "SUPPORT_LEARNING_REVIEWS", "queue": "pegma-dev-support-learning-reviews" },
    ],
    "consumers": [
      { "queue": "pegma-dev-support-learning-reviews", "max_batch_size": 1,
        "max_retries": 3, "dead_letter_queue": "pegma-dev-support-learning-reviews-dlq" },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
