{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pegma-dev-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pegma.dev/api/*",
      "zone_name": "pegma.dev",
    },
  ],
  "vars": {
    "IDENTITY_EMAIL_FROM": "Pegma <identity@pegma.dev>",
    "IDENTITY_EMAIL_ENABLED": "false",
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "pegma-dev-identity",
      "database_id": "fe188a7f-7b5e-4889-bcfc-6150b64d45ae",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
