{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pegma-dev-support-checker-cpu-stage",
  "main": "src/support-checker-cpu-stage-entry.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": [] },
  "queues": {
    "consumers": [
      {
        "queue": "pegma-support-checker-cpu-stage-wakeup",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
        "max_retries": 0,
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
}
