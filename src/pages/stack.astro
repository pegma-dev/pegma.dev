---
import Base from '../layouts/Base.astro';
import { components, SNAPSHOT_DATE } from '../data/components';
import { planStage } from '../data/live-status';

const withStage = await Promise.all(
  components.map(async (c) => ({ ...c, stage: await planStage(c.repo, c.plan) })),
);
---

<Base
  title="The stack — Pegma"
  description="Every Pegma component: what it owns, what it refuses, and where it stands."
>
  <section class="hero">
    <h1>The stack</h1>
    <p class="lede">
      One repository per component, publishing under the <code>@pegma</code> scope. What a
      component <em>refuses</em> to do is part of its contract — read both columns.
    </p>
    <p class="notice">
      "Now" lines are compiled at build time from each repository's public
      <code>docs/PROJECT_PLAN.md</code> where one exists; the rest fall back to a snapshot dated
      {SNAPSHOT_DATE}. The repos are the source of truth.
    </p>
  </section>

  {
    withStage.map((c) => (
      <section class="component" id={c.repo}>
        <header>
          <h3>{c.title}</h3>
          <span class="status" data-status={c.status}>
            {c.status}
          </span>
          <span class="pkgs">{c.packages.join(' · ')}</span>
        </header>
        <p>{c.summary}</p>
        <div class="two-col">
          <div class="col">
            <h4>Owns</h4>
            <ul>
              {c.owns.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="col">
            <h4>Refuses</h4>
            <ul>
              {c.refuses.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
        <p class="now-line">
          <strong>Now:</strong> {c.stage ?? c.now} —{' '}
          <a href={`https://github.com/pegma-dev/${c.repo}`}>repository</a>
          {c.plan && (
            <>
              {' · '}
              <a href={`https://github.com/pegma-dev/${c.repo}/blob/main/${c.plan}`}>plan</a>
            </>
          )}
        </p>
      </section>
    ))
  }
</Base>
