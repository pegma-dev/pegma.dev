---
import Base from '../../../layouts/Base.astro';
---

<Base title="Authorize an agent - Pegma" description="Review a registered agent's request using your existing Pegma account.">
  <section class="account-hero" data-agent-flow="authorization_code">
    <p class="eyebrow">Account · Agent access</p>
    <h1>Review agent access</h1>
    <p class="lede">Review the client, resource, and permissions before deciding. Approval requires your current Admin access.</p>
  </section>
  <p id="agent-status" class="notice" role="status" aria-live="polite">Checking your account access...</p>
  <section id="agent-signed-out" class="account-panel" hidden>
    <h2>Sign in required</h2>
    <p>Use your existing Pegma account, then return to this request.</p>
    <a id="agent-sign-in" href="/account">Sign in</a>
  </section>
  <section id="agent-panel" class="account-panel" hidden>
    <p id="agent-resource" class="form-note"></p>
    <section id="agent-request" hidden>
      <h2 id="agent-client"></h2>
      <dl id="agent-details"></dl>
      <form id="agent-consent" class="account-form">
        <fieldset>
          <legend>Permissions to approve</legend>
          <div id="agent-scopes"></div>
        </fieldset>
        <p>Access remains subject to your current permissions. Sign-out does not revoke an agent grant; use the grant controls below.</p>
        <div class="account-inline">
          <button type="submit" name="decision" value="approve">Approve selected permissions</button>
          <button type="submit" name="decision" value="deny" class="secondary-button">Deny</button>
        </div>
      </form>
    </section>
    <section>
      <h2>View or revoke a known grant</h2>
      <p>Enter the grant ID from your approval. Only your own grants are available here.</p>
      <form id="agent-grant-lookup" class="account-form">
        <label for="agent-grant-id">Grant ID</label>
        <input id="agent-grant-id" name="grantId" type="text" maxlength="512" required autocomplete="off" />
        <button type="submit">View grant</button>
      </form>
      <section id="agent-grant" hidden>
        <dl id="agent-grant-details"></dl>
        <button id="agent-revoke" type="button" class="secondary-button">Revoke this grant</button>
      </section>
    </section>
    <p><a href="/account/agents/device">Enter a device code</a> · <a href="/account">Account</a> · <a href="/knowledge">Guides</a></p>
  </section>
  <noscript><p class="notice">Reviewing agent access requires JavaScript and a signed-in Admin session.</p></noscript>
  <script is:inline type="module" src="/agent-access.js"></script>
</Base>
