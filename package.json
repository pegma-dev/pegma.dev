{
  "name": "pegma.dev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit && tsc -p recipes/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.d1.config.ts",
    "test:node": "vitest run --config vitest.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "preview": "astro preview",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc",
    "worker:tail": "wrangler tail pegma-dev-api",
    "worker:types": "wrangler types worker/worker-configuration.d.ts -c worker/wrangler.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@pegma/audit": "0.1.0",
    "@pegma/authorization-core": "0.1.2",
    "@pegma/authorization-identity": "0.1.2",
    "@pegma/health": "^0.1.1",
    "@pegma/identity": "0.1.0",
    "@pegma/logger-cloudflare": "^0.1.1",
    "@pegma/logger-datadog": "^0.1.1",
    "@pegma/logger-tee": "^0.1.1",
    "@pegma/mail": "0.1.0",
    "@pegma/rate-limit": "0.1.0",
    "@pegma/sessions": "0.1.0",
    "@pegma/spine": "^0.1.1",
    "@pegma/storage-cloudflare-d1": "0.4.0",
    "@pegma/storage-core": "0.4.0",
    "@pegma/support-desk-application": "0.1.0",
    "@pegma/support-desk-contracts": "0.1.0",
    "@pegma/support-desk-core": "0.1.0",
    "@pegma/support-desk-templates": "0.1.0",
    "@pegma/webhooks": "file:vendor/@pegma/webhooks/pegma-webhooks-0.0.0.tgz",
    "agents": "^0.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@types/node": "26.1.1",
    "astro": "7.1.4",
    "typescript": "^5.9.2",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0"
  }
}
