{
  "name": "pegma.dev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit && tsc -p recipes/tsconfig.json --noEmit && pnpm run check:worker && pnpm run check:assistant-stage && pnpm run check:checker-cpu-stage",
    "check:worker": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir .wrangler/worker-dry-run",
    "check:assistant-stage": "tsc -p scripts/tsconfig.support-assistant-stage.json --noEmit && wrangler deploy --config worker/wrangler.assistant-stage.jsonc --dry-run --outdir .wrangler/assistant-stage-dry-run",
    "check:checker-cpu-stage": "wrangler deploy --config worker/wrangler.checker-cpu-stage.jsonc --dry-run --outdir .wrangler/checker-cpu-stage-dry-run",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.d1.config.ts && vitest run --config vitest.bench-ticket.config.ts",
    "test:node": "vitest run --config vitest.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts && vitest run --config vitest.bench-ticket.config.ts",
    "eval:assembly": "vitest run --config vitest.config.ts evals/assembly-eval.test.ts",
    "preview": "astro preview",
    "demo:bench-ticket": "tsx recipes/bench-ticket/host.ts",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc",
    "worker:tail": "wrangler tail pegma-dev-api",
    "worker:types": "wrangler types worker/worker-configuration.d.ts -c worker/wrangler.jsonc && node scripts/normalize-worker-types.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@pegma/agent-access": "0.1.1",
    "@pegma/audit": "0.2.0",
    "@pegma/authorization-admin": "0.4.0",
    "@pegma/authorization-core": "0.4.0",
    "@pegma/authorization-identity": "0.4.0",
    "@pegma/authorization-policy": "0.4.0",
    "@pegma/authorization-storage": "0.4.0",
    "@pegma/health": "^0.2.0",
    "@pegma/identity": "0.1.2",
    "@pegma/knowledge-base-application": "0.1.8",
    "@pegma/knowledge-base-contracts": "0.1.8",
    "@pegma/knowledge-base-core": "0.1.8",
    "@pegma/knowledge-base-mcp": "0.1.8",
    "@pegma/logger-cloudflare": "^0.1.1",
    "@pegma/logger-datadog": "^0.1.1",
    "@pegma/logger-tee": "^0.1.1",
    "@pegma/mail": "0.1.1",
    "@pegma/rate-limit": "0.2.0",
    "@pegma/rate-limit-paged": "npm:@pegma/rate-limit@0.3.3",
    "@pegma/sessions": "0.3.0",
    "@pegma/spine": "^0.1.1",
    "@pegma/storage-cloudflare-d1": "0.4.7",
    "@pegma/storage-core": "0.4.0",
    "@pegma/support-desk-ai": "0.2.13",
    "@pegma/support-desk-application": "0.2.13",
    "@pegma/support-desk-contracts": "0.2.13",
    "@pegma/support-desk-core": "0.2.13",
    "@pegma/support-desk-templates": "0.2.13",
    "@pegma/webhooks": "0.1.1",
    "agents": "^0.20.1",
    "gpt-tokenizer": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@types/node": "26.1.1",
    "astro": "7.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.128.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "agents>@modelcontextprotocol/sdk": "1.32.2",
      "agents>@modelcontextprotocol/client": "2.3.0",
      "agents>@modelcontextprotocol/server": "2.3.0",
      "express@5.2.1>body-parser": "2.4.0",
      "express@5.2.1>proxy-addr": "2.0.8",
      "ajv@8.20.0>fast-uri": "3.1.9"
    }
  }
}
